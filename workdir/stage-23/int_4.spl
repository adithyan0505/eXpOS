alias sysCallNum R1;
alias userSP R2;
userSP = SP;
sysCallNum = [[PTBR + 2 * (userSP - 5) / 512] * 512 + (userSP - 5) % 512];
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

if(sysCallNum == 1) then
    //create file
    alias procTabIdx R3;
    procTabIdx = PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16;
    [procTabIdx + 9] = 1;

    alias fileName R4;
    alias perm R5;
    fileName = [[PTBR + 2 * (userSP - 4) / 512] * 512 + (userSP - 4) % 512];
    perm = [[PTBR + 2 * (userSP - 3) / 512] * 512 + (userSP - 3) % 512];

    alias inodeIdx R6;
    inodeIdx = 0;
    alias retValLoc R7;
    retValLoc = [PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512;

    while(inodeIdx < MAX_FILE_NUM) do 
        if([INODE_TABLE + inodeIdx * 16 + 1] == fileName) then
            [retValLoc] = 0;
            [procTabIdx + 9] = 0;
            SP = userSP;
            ireturn;
        endif;
        inodeIdx = inodeIdx + 1;
    endwhile;

    inodeIdx = 0;
    while(inodeIdx < MAX_FILE_NUM) do 
        if([INODE_TABLE + inodeIdx * 16 + 1] == -1) then
            break;
        endif;
        inodeIdx = inodeIdx + 1;
    endwhile;
    if(inodeIdx == MAX_FILE_NUM) then
        [retValLoc] = -1;
        [procTabIdx + 9] = 0;
        SP = userSP;
        ireturn;
    endif;

    alias inodeEntry R8;
    inodeEntry = INODE_TABLE + inodeIdx * 16;
    [inodeEntry] = DATA;
    [inodeEntry + 1] = fileName;
    [inodeEntry + 2] = 0;
    [inodeEntry + 3] = [procTabIdx + 3];
    [inodeEntry + 4] = perm;
    [inodeEntry + 8] = -1;
    [inodeEntry + 9] = -1;
    [inodeEntry + 10] = -1;
    [inodeEntry + 11] = -1;
    
    alias rootEntry R9;
    rootEntry = ROOT_FILE + inodeIdx * 8;
    [rootEntry] = fileName;
    [rootEntry + 1] = 0;
    [rootEntry + 2] = DATA;
    [rootEntry + 3] = [USER_TABLE + [procTabIdx + 3] * 2];
    [rootEntry + 4] = perm;

    [retValLoc] = 0;
    [procTabIdx + 9] = 0;
    SP = userSP;
    ireturn;
endif;

if(sysCallNum == 4) then
    //delete file
    alias procTabIdx R3;
    procTabIdx = PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16;
    [procTabIdx + 9] = 4;

    alias fileName R4;
    fileName = [[PTBR + 2 * (userSP - 4) / 512] * 512 + (userSP - 4) % 512];

    alias inodeIdx R6;
    inodeIdx = 1;
    alias retValLoc R7;
    retValLoc = [PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512;

    while(inodeIdx < MAX_FILE_NUM) do 
        alias inodeEntry R8;
        inodeEntry = INODE_TABLE + inodeIdx * 16;
        if([inodeEntry + 1] == fileName) then
            if([inodeEntry] != DATA) then
                inodeIdx = -1;
                break;
            endif;
            if([inodeEntry + 4] == EXCLUSIVE) then
                if(([SYSTEM_STATUS_TABLE] != ROOT) && ([inodeEntry + 3] != [SYSTEM_STATUS_TABLE])) then
                    inodeIdx = -1;
                    break;
                endif;
            endif;
            break;
        endif;
        inodeIdx = inodeIdx + 1;
    endwhile;
    if(inodeIdx == MAX_FILE_NUM) then
        [retValLoc] = 0;
        [procTabIdx + 9] = 0;
        SP = userSP;
        ireturn;
    endif;
    if(inodeIdx == -1) then
        [retValLoc] = -1;
        [procTabIdx + 9] = 0;
        SP = userSP;
        ireturn;
    endif;

    multipush(R1,R2,R3,R4,R5,R6,R7);
    R1 = ACQUIRE_INODE; R2 = inodeIdx; R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3,R4,R5,R6,R7);

    if(R0 == -1) then
        [retValLoc] = -1;
        [procTabIdx + 9] = 0;
        SP = userSP;
        ireturn;
    endif;

    if([FILE_STATUS_TABLE + inodeIdx * 4 + 1] != -1) then
        multipush(R1,R2,R3,R4,R5,R6,R7);
        R1 = RELEASE_INODE; R2 = inodeIdx; R3 = [SYSTEM_STATUS_TABLE + 1];
        call RESOURCE_MANAGER;
        multipop(R1,R2,R3,R4,R5,R6,R7);

        [retValLoc] = -2;
        [procTabIdx + 9] = 0;
        SP = userSP;
        ireturn;
    endif;

    alias inodeEntry R8;
    inodeEntry =  INODE_TABLE + inodeIdx * 16;
    alias i R9;
    i = 0;
    while(i < 4) do 
        alias blockNum R10;
        blockNum = [inodeEntry + 8 + i];
        if(blockNum != -1) then 
            if([BUFFER_TABLE + (blockNum % MAX_BUFFER) * 4] == blockNum) then
                //reset dirty bit
                [BUFFER_TABLE + (blockNum % MAX_BUFFER) * 4 + 1] = 0;
            endif;
            //release block
            multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);
            R1 = RELEASE_BLOCK; R2 = blockNum; R3 = [SYSTEM_STATUS_TABLE + 1];
            call MEMORY_MANAGER;
            multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);
        endif;
        i = i + 1;
    endwhile;

    i = 0;
    while(i < 16) do 
        [inodeEntry + i] = -1;
        i = i + 1;
    endwhile;

    alias rootEntry R10;
    rootEntry = ROOT_FILE + inodeIdx * 8;
    i = 0;
    while(i < 8) do 
        [rootEntry + i] = -1;
        i = i + 1;
    endwhile;
    
    multipush(R1,R2,R3,R4,R5,R6,R7);
    R1 = RELEASE_INODE; R2 = inodeIdx; R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3,R4,R5,R6,R7);
    
    [retValLoc] = 0;
    [procTabIdx + 9] = 0;
    SP = userSP;
    ireturn;
endif;