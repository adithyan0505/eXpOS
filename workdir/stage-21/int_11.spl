alias sysCallNum R1;
alias userSP R2;
userSP = SP;
sysCallNum = [[PTBR + 2 * (userSP - 5) / 512] * 512 + (userSP - 5) % 512];
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

if(sysCallNum == INT_GETPID) then
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = INT_GETPID;
    [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = [SYSTEM_STATUS_TABLE + 1];
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    SP = userSP;
    ireturn;
endif;

if(sysCallNum == INT_GETPPID) then
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = INT_GETPPID;
    [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE] * 16 + 2];
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    SP = userSP;
    ireturn;
endif;

if(sysCallNum == INT_WAIT) then
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = INT_WAIT;
    alias argPID R3;
    argPID = [[PTBR + 2 * (userSP - 4) / 512] * 512 + (userSP - 4) % 512];
    if((argPID < 0) || (argPID >= MAX_PROC_NUM) || ([PROCESS_TABLE + argPID * 16 + 4] == TERMINATED) || (argPID == [SYSTEM_STATUS_TABLE + 1])) then
        [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = -1;
        [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
        SP = userSP;
        ireturn; 
    endif;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 4] = WAIT_PROCESS;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 5] = argPID;
    multipush(R1,R2,R3);
    call SCHEDULER;
    multipop(R1,R2,R3);
    [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = 0;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    SP = userSP;
    ireturn; 
endif;

if(sysCallNum == INT_SIGNAL) then
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = INT_SIGNAL;
    alias ipid R3;
    ipid = 0;
    while(ipid < MAX_PROC_NUM) do
        if([PROCESS_TABLE + ipid * 16 + 4] == WAIT_PROCESS) then
            if([PROCESS_TABLE + ipid * 16 + 5] == [SYSTEM_STATUS_TABLE + 1]) then
                [PROCESS_TABLE + ipid * 16 + 4] = READY;
            endif;
        endif;
        ipid = ipid + 1;
    endwhile;
    [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = 0;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    SP = userSP;
    ireturn;
endif;