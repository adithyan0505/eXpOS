//PROCESS MANAGER MODULE
alias funcNum R1;
alias PID R2;

if(funcNum == FREE_USER_AREA_PAGE) then	
	alias procTabIdx R3;
	procTabIdx = PROCESS_TABLE + PID * 16;

	alias rtAddr R4;
    alias idx R5;
    idx = 0;
    rtAddr = [procTabIdx + 11] * 512 + RESOURCE_TABLE_OFFSET;
    while(idx < 8) do
        if([rtAddr + idx * 2] == SEMAPHORE) then
            multipush(R1,R2,R3,R4,R5);
			R1 = RELEASE_SEMAPHORE; R3 = PID; R2 = [rtAddr + idx * 2 + 1];
			call RESOURCE_MANAGER;
			multipop(R1,R2,R3,R4,R5);
        endif;
		if([rtAddr + idx * 2] == FILE) then
			multipush(R1,R2,R3,R4,R5);
			R1 = CLOSE; R2 = [rtAddr + idx * 2 + 1];
			call FILE_MANAGER;
			multipop(R1,R2,R3,R4,R5);
		endif;
        idx = idx + 1;
    endwhile;
	
	multipush(R1,R2);
	//call RELEASE_PAGE
	R1 = 2;
	R2 = [procTabIdx + 11];
	call MOD_2;
	multipop(R1,R2);

	return;
endif;

if(funcNum == EXIT_PROCESS) then
	multipush(R1,R2);
	//call FREE_PAGE_TABLE
	R1 = 4; R2 = PID;
	call MOD_1;
	//call FREE_USER_AREA_PAGE
	R1 = 2; R2 = PID;
	call MOD_1; 
	multipop(R1,R2);
	[PROCESS_TABLE + PID * 16 + 4] = TERMINATED;
	if([PROCESS_TABLE + PID * 16 + 9] != 9) then
		alias ipid R3;
		ipid = 0;
		while(ipid < MAX_PROC_NUM) do
			alias procTabEntry R4;
			procTabEntry = PROCESS_TABLE + ipid * 16;
			if([procTabEntry + 4] == WAIT_PROCESS) then
				if([procTabEntry + 5] == PID) then
					[procTabEntry + 4] = READY;
				endif;
			endif;
			if([procTabEntry + 2] == PID) then
				[procTabEntry + 2] = -1;
			endif;
			ipid = ipid + 1;
		endwhile;
	endif;
	return;
endif;

if(funcNum == FREE_PAGE_TABLE) then
	alias ptbr R4;
	ptbr = [PROCESS_TABLE + PID * 16 + 14];
	[ptbr+0] = -1;
	[ptbr+1] = "0000";
	[ptbr+2] = -1;
	[ptbr+3] = "0000";
	alias i R3;
	i = 2;
	while(i < 10) do
		if([ptbr + 2 * i] != -1) then
			multipush(R1,R2,R3,R4);
			//call RELEASE_PAGE
			R1 = 2;
			R2 = [ptbr + 2 * i];
			call MOD_2;					
			multipop(R1,R2,R3,R4);
			//invalidate entry
			[ptbr + 2 * i] = -1;
			[ptbr + 2 * i + 1] = "0000";
		endif;
		i = i + 1;	
	endwhile;
	
	//invalidate DISK MAP TABLE entries
	//release Heap disk blocks
	i = 2;
	alias blockNum R4;
	while(i <= 3) do
		blockNum = [DISK_MAP_TABLE + PID * 10 + i];
		if(blockNum != -1) then
			//invoke RELEASE_BLOCK of MEMORY_MANAGER_MODULE
			multipush(R1,R2,R3,R4);
			R3 = PID; R2 = blockNum; R1 = RELEASE_BLOCK;
			call MOD_2;
			multipop(R1,R2,R3,R4);
			[DISK_MAP_TABLE + PID * 10 + i] = -1;
		endif;
		i = i + 1;
	endwhile;
	//release Stack disk blocks
	i = 8;
	while(i <= 9) do
		blockNum = [DISK_MAP_TABLE + PID * 10 + i];
		if(blockNum != -1) then
			//invoke RELEASE_BLOCK of MEMORY_MANAGER_MODULE
			multipush(R1,R2,R3,R4);
			R3 = PID; R2 = blockNum; R1 = RELEASE_BLOCK;
			call MOD_2;
			multipop(R1,R2,R3,R4);
			[DISK_MAP_TABLE + PID * 10 + i] = -1;
		endif;
		i = i + 1;
	endwhile;
	//invalidate code entries
	i = 4;
	while(i <= 7) do
		[DISK_MAP_TABLE + PID * 10 + i] = -1;
		i = i + 1;
	endwhile;
	return;
endif;

if(funcNum == GET_PCB_ENTRY) then
	alias pid R0;
	alias cpid R1;
	pid = -1;
	cpid = 1;
	while(cpid < MAX_PROC_NUM) do
		if([PROCESS_TABLE + cpid * 16 + 4] == TERMINATED) then
			pid = cpid;
			[PROCESS_TABLE + pid * 16 + 1] = pid;
			[PROCESS_TABLE + pid * 16 + 4] = ALLOCATED;
			[PROCESS_TABLE + pid * 16 + 14] = PAGE_TABLE_BASE + pid * 20;
			[PROCESS_TABLE + pid * 16 + 15] = PTLR;
			break;
		endif;
		cpid = cpid + 1;
	endwhile;
	return;
endif;

if(funcNum == KILL_ALL) then
	alias inodeIdx R3;
	inodeIdx = 0;
	while(inodeIdx < MAX_FILE_NUM) do
		if([INODE_TABLE + inodeIdx * 16 + 1] != -1) then
			multipush(R1,R2,R3);
			R1 = ACQUIRE_INODE; R2 = inodeIdx; R3 = PID;
			call RESOURCE_MANAGER;
			multipop(R1,R2,R3);
		endif;
		inodeIdx = inodeIdx + 1;
	endwhile;

	alias ipid R4;
	ipid = 2;
	//exclude IDLE, INIT (Login), Swapper Daemon
	while(ipid < MAX_PROC_NUM - 1) do 
		if((ipid != PID) && ([PROCESS_TABLE + ipid * 16 + 4] != TERMINATED)) then
			multipush(R1,R2,R3,R4);
			R1 = EXIT_PROCESS; R2 = ipid;
			call PROCESS_MANAGER;
			multipop(R1,R2,R3,R4);
		endif;
		ipid = ipid + 1;
	endwhile;

	inodeIdx = 0;
	while(inodeIdx < MAX_FILE_NUM) do
		if([INODE_TABLE + inodeIdx * 16 + 1] != -1) then
			multipush(R1,R2,R3);
			R1 = RELEASE_INODE; R2 = inodeIdx; R3 = PID;
			call RESOURCE_MANAGER;
			multipop(R1,R2,R3);
		endif;
		inodeIdx = inodeIdx + 1;
	endwhile;
	return;
endif;