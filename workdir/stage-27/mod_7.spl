// load library code from disk to memory
loadi(63,13);
loadi(64,14);
// load INIT from disk to memory
loadi(65,7);
// load INT 10 from disk to memory
loadi(22,35);
loadi(23,36);
// load exception handler routine
loadi(2,15);
loadi(3,16);
// load timer interrupt routine
loadi(4,17);
loadi(5,18);
// load INT 7 from disk to memory
loadi(16,29);
loadi(17,30);
// load MODULE_5 (scheduler)
loadi(50,63);
loadi(51,64);
// load MODULE_4 (Device Manager)
loadi(48,61);
loadi(49,62);
// load MODULE_0 (Resource Manager)
loadi(40,53);
loadi(41,54);
// load console interrupt routine
loadi(8,21);
loadi(9,22);
// load INT 6
loadi(14,27);
loadi(15,28);
// load INT 9
loadi(20,33);
loadi(21,34);
// load MODULE_1 (Process Manager)
loadi(42,55);
loadi(43,56);
// load MODULE_2 (Memory Manager)
loadi(44,57);
loadi(45,58);
// load Inode + User Table
loadi(59,3);
loadi(60,4);
// load disk interrupt routine
loadi(6,19);
loadi(7,20);
// load Disk Free List
loadi(61,2);
// load INT 8
loadi(18,31);
loadi(19,32);
// load INT 11
loadi(24,37);
loadi(25,38);
// load INT 15
loadi(32,45);
loadi(33,46);
// load INT 13
loadi(28,41);
loadi(29,42);
// load INT 14
loadi(30,43);
loadi(31,44);
// load INT 4
loadi(10,23);
loadi(11,24);
// load root file
loadi(62,5);
// load INT 5
loadi(12,25);
loadi(13,26);
// load MOD 3
loadi(46,59);
loadi(47,60);
// load shell program
loadi(67,9);
loadi(68,10);
// load INT 16
loadi(34,47);
loadi(35,48);
// load INT 12
loadi(26,39);
loadi(27,40);
// load INT 17
loadi(36,49);
loadi(37,50);
// load MOD 6
loadi(52,65);
loadi(53,66);

alias process_table R0; 

// INIT (Login) process (PID 1)

// SETUP PAGE TABLE
PTBR = PAGE_TABLE_BASE + 20;
PTLR = 10;

alias t R1;
t = 0;
while(t < 10) do 
	[PTBR + 2 * t] = -1;
	[PTBR + 2 * t + 1] = "0000";
	t = t + 1;
endwhile;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";
//Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
//Stack
[PTBR+16] = 66;
[PTBR+17] = "0110";

// SETUP PROCESS TABLE
process_table = PROCESS_TABLE + 16;
//PID, UAPN, UPTR, KPTR, PTBR, PTLR, STATUS
[process_table+0] = 0;
[process_table+1] = LOGIN_PROCESS;
[process_table+3] = KERNEL;
[process_table+11] = 76;
[process_table+13] = 8*512;
[process_table+12] = 0;
[process_table+14] = PTBR;
[process_table+15] = PTLR;
[process_table+4] = CREATED;
[process_table+6] = 0;

// set IP to start of code when mode changes from kernel to user
[66 * 512] = [65 * 512 + 1];

// Initialize PER-PROCESS RESOURCE TABLE for INIT
alias resource_table R2;
t = 0;
resource_table = [process_table + 11] * 512 + RESOURCE_TABLE_OFFSET;
while(t < 16) do
	[resource_table + t] = -1;
	t = t + 1;
endwhile;

// SHELL process (PID 2)

// page table setup
PTBR = PAGE_TABLE_BASE + 40;
PTLR = 10;

t = 0;
while(t < 10) do 
	[PTBR + 2 * t] = -1;
	[PTBR + 2 * t + 1] = "0000";
	t = t + 1;
endwhile;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";
//Code
[PTBR+8] = 67;
[PTBR+9] = "0100";
[PTBR+10] = 68;
[PTBR+11] = "0100";
//Stack
[PTBR+16] = 78;
[PTBR+17] = "0110";
[PTBR+18] = 79;
[PTBR+19] = "0110";

// SETUP PROCESS TABLE
process_table = PROCESS_TABLE + 32;
//PID, UAPN, UPTR, KPTR, PTBR, PTLR, STATUS
[process_table+0] = 0;
[process_table+1] = SHELL_PROCESS;
[process_table+2] = LOGIN_PROCESS;
[process_table+11] = 80;
[process_table+13] = 8*512;
[process_table+12] = 0;
[process_table+14] = PTBR;
[process_table+15] = PTLR;
[process_table+4] = TERMINATED;
[process_table+6] = 0;

// set IP to start of code when mode changes from kernel to user
[78 * 512] = [67 * 512 + 1];

// Initialize PER-PROCESS RESOURCE TABLE for SHELL
t = 0;
resource_table = [process_table + 11] * 512 + RESOURCE_TABLE_OFFSET;
while(t < 16) do
	[resource_table + t] = -1;
	t = t + 1;
endwhile;

// Initialize PER-PROCESS DISK MAP TABLE for SHELL
t = 0;
alias dmaptab R2;
dmaptab = DISK_MAP_TABLE + 20;
while(t < 10) do 
	[dmaptab + t] = -1;
	t = t + 1;
endwhile;
[DISK_MAP_TABLE + 20 + 4] = 9;
[DISK_MAP_TABLE + 20 + 5] = 10;

// Initialize STATE field for remaining entries in PROCESS TABLE
t = 3;
while(t < 15) do
	process_table = process_table + 16;	
	[process_table+4] = TERMINATED;
	//initialize tick for all processes
	[process_table] = 0;
	t = t + 1;
endwhile;

// Initialize STATUS in Terminal Status Table
[TERMINAL_STATUS_TABLE] = 0;

// Initialize Memory Free List
t = 0;
while(t < NUM_MEM_PAGES) do
	if(t <= 82) then
		[MEMORY_FREE_LIST + t] = 1;
	else
		[MEMORY_FREE_LIST + t] = 0;
	endif;
	t = t + 1;
endwhile;
// Initialize MEM_FREE_COUNT
[SYSTEM_STATUS_TABLE + 2] = 45;
// Initialize WAIT_MEM_COUNT
[SYSTEM_STATUS_TABLE + 3] = 0;

// Initialize STATUS in Disk Status Table
[DISK_STATUS_TABLE] = 0;

//initialise semaphore table
t = 0;
while(t < MAX_SEM_COUNT) do
	[SEMAPHORE_TABLE + t * 4] = -1;
	[SEMAPHORE_TABLE + t * 4 + 1] = 0;
	t = t + 1;
endwhile;

//initialise file status table
t = 0;
while(t < MAX_FILE_NUM) do 
	[FILE_STATUS_TABLE + t * 4] = -1;
	[FILE_STATUS_TABLE + t * 4 + 1] = -1;
	t = t + 1;
endwhile;

//initialise buffer table
t = 0;
while(t < 4) do 
	alias bt R3;
	bt = BUFFER_TABLE + t * 4;
	[bt] = -1;
	[bt + 1] = 0;
	[bt + 2] = -1;
	t = t + 1;
endwhile;

//initialize open file table
t = 0;
while(t < MAX_OPENFILE_NUM) do 
	[OPEN_FILE_TABLE + t * 4] = -1;
	[OPEN_FILE_TABLE + t * 4 + 1] = 0;
	t = t + 1;
endwhile;

//initialize SWAPPED_COUNT, PAGING STATUS
[SYSTEM_STATUS_TABLE + 4] = 0;
[SYSTEM_STATUS_TABLE + 5] = 0;

// return to caller (OS startup code)
return;
