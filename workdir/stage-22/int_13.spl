alias sysCallNum R1;
alias userSP R2;
userSP = SP;
sysCallNum = [[PTBR + 2 * (userSP - 5) / 512] * 512 + (userSP - 5) % 512];
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

if(sysCallNum == 17) then
    //Semget
    alias procTabIdx R3;
    procTabIdx = PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16;
    [procTabIdx + 9] = 17;

    alias rtAddr R4;
    alias idx R5;
    idx = 0;
    rtAddr = [procTabIdx + 11] * 512 + RESOURCE_TABLE_OFFSET;
    while(idx < 8) do
        if([rtAddr + idx * 2] == -1) then
            break;
        endif;
        idx = idx + 1;
    endwhile;
    if(idx == 8) then
        [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = -1;
        [procTabIdx + 9] = 0;
        SP = userSP;
        ireturn; 
    endif;

    [rtAddr + idx * 2] = SEMAPHORE;

    multipush(R1,R2,R3,R4,R5);
    R1 = ACQUIRE_SEMAPHORE; R2 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3,R4,R5);
    if(R0 == -1) then
        [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = -2;
        [procTabIdx + 9] = 0;
        SP = userSP;
        ireturn; 
    endif;

    [rtAddr + idx * 2 + 1] = R0;
    [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = idx;

    [procTabIdx + 9] = 0;
    SP = userSP;
    ireturn;
endif;

if(sysCallNum == 18) then
    //Semrelease
    alias semId R3;
    semId = [[PTBR + 2 * (userSP - 4) / 512] * 512 + (userSP - 4) % 512];
    alias procTabIdx R4;
    procTabIdx = PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16;
    [procTabIdx + 9] = 18;
    alias rtAddr R5;
    rtAddr = [procTabIdx + 11] * 512 + RESOURCE_TABLE_OFFSET + 2 * semId;

    if((semId < 0) || (semId > 7) || ([rtAddr] != 1)) then
        [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = -1;
        [procTabIdx + 9] = 0;
        SP = userSP;
        ireturn;
    endif;

    multipush(R1,R2,R3,R4,R5);
    R1 = RELEASE_SEMAPHORE; R2 = [rtAddr + 1]; R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3,R4,R5);
    [rtAddr] = -1;
    [rtAddr + 1] = -1;

    [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = 0;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    SP = userSP;
    ireturn;
endif;
