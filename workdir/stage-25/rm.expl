int main() {
    decl
        int temp;
        string fileName;
    enddecl
    begin
        temp = exposcall("Read",-1,fileName);
        temp = exposcall("Delete",fileName);
        if(temp == -1) then
            temp = exposcall("Write",-2,"Perm Denied");
        else
            if(temp == -2) then
                temp = exposcall("Write",-2,"File is open");
            endif;
        endif;
        return 0;
    end
}