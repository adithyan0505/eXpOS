//FILE MANAGER MODULE
alias funcNum R1;

if(funcNum == OPEN) then
    alias fileName R2;
    alias inodeIdx R3;
    inodeIdx = 0;
    while(inodeIdx < MAX_FILE_NUM) do
        if([INODE_TABLE + inodeIdx * 16 + 1] == fileName) then
            break;
        endif;
        inodeIdx = inodeIdx + 1;
    endwhile;
    if(inodeIdx == MAX_FILE_NUM) then
        R0 = -1;
        return;
    endif;

    multipush(R1,R2,R3);
    R1 = ACQUIRE_INODE; R2 = inodeIdx; R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3);
    if(R0 == -1) then
        return;
    endif;

    if([INODE_TABLE + inodeIdx * 16] == EXEC) then
        multipush(R1,R2,R3);
        R1 = RELEASE_INODE; R2 = inodeIdx; R3 = [SYSTEM_STATUS_TABLE + 1];
        call RESOURCE_MANAGER;
        multipop(R1,R2,R3);
        R0 = -1;
        return;
    endif;

    alias oftIdx R4;
    oftIdx = 0;
    while(oftIdx < MAX_OPENFILE_NUM) do
        if([OPEN_FILE_TABLE + oftIdx * 4] == -1) then
            break;
        endif;
        oftIdx = oftIdx + 1;
    endwhile;
    if(oftIdx == MAX_OPENFILE_NUM) then
        multipush(R1,R2,R3,R4);
        R1 = RELEASE_INODE; R2 = inodeIdx; R3 = [SYSTEM_STATUS_TABLE + 1];
        call RESOURCE_MANAGER;
        multipop(R1,R2,R3,R4);
        R0 = -2;
        return;
    endif;
    alias oftEntry R6;
    oftEntry = OPEN_FILE_TABLE + oftIdx * 4;

    if(fileName == "root") then
        [oftEntry] = INODE_ROOT;
    else
        alias fstEntry R5;
        fstEntry = FILE_STATUS_TABLE + inodeIdx * 4 + 1;
        if([fstEntry] == -1) then
            [fstEntry] = 1;
        else
            [fstEntry] = [fstEntry] + 1;
        endif;
        [oftEntry] = inodeIdx;
    endif;

    [oftEntry + 1] = 1;
    [oftEntry + 2] = 0;

    multipush(R1,R2,R3,R4);
    R1 = RELEASE_INODE; R2 = inodeIdx; R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3,R4);

    R0 = oftIdx;
    return;
endif;

if(funcNum == CLOSE) then
    alias oftIdx R2;
    alias inodeIdx R3;
    alias oftEntry R4;
    oftEntry = OPEN_FILE_TABLE + oftIdx * 4;

    inodeIdx = [oftEntry];
    [oftEntry + 1] = [oftEntry + 1] - 1;

    if([oftEntry + 1] == 0) then
        [oftEntry] = -1;
        [oftEntry + 1] = -1;
        if([INODE_TABLE + inodeIdx * 16 + 1] != "root") then
            alias fstEntry R5;
            fstEntry = FILE_STATUS_TABLE + inodeIdx * 4 + 1;
            [fstEntry] = [fstEntry] - 1;
            if([fstEntry] == 0) then
                [fstEntry] = -1;
            endif;
        endif;
    endif;
    return;
endif;

if((funcNum == BUFFERED_READ) || (funcNum == BUFFERED_WRITE)) then
    alias dblk R2;
    alias offset R3;
    alias word R4;
    alias buffNum R5;
    buffNum = dblk % 4;

    multipush(R1,R2,R3,R4,R5);
    R1 = ACQUIRE_BUFFER; R2 = buffNum; R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER; 
    multipop(R1,R2,R3,R4,R5);

    alias buffTab R6;
    buffTab = BUFFER_TABLE + buffNum * 4;
    if([buffTab] != dblk) then
        if(([buffTab] != -1) && ([buffTab + 1] == 1)) then
            multipush(R1,R2,R3,R4,R5,R6);
            R1 = DISK_STORE; R2 = [SYSTEM_STATUS_TABLE + 1]; R3 = BUFFER_BASE + buffNum; R4 = [buffTab];
            call DEVICE_MANAGER;
            multipop(R1,R2,R3,R4,R5,R6);
            [buffTab + 1] = 0;
        endif;
        multipush(R1,R2,R3,R4,R5,R6);
        R1 = DISK_LOAD; R4 = dblk; R2 = [SYSTEM_STATUS_TABLE + 1]; R3 = BUFFER_BASE + buffNum;
        call DEVICE_MANAGER;
        multipop(R1,R2,R3,R4,R5,R6);
        [buffTab] = dblk;
    endif;

    if(funcNum == BUFFERED_READ) then
        alias waddr R7;
        waddr = [PTBR + 2 * word / 512] * 512 + (word % 512);
        [waddr] = [(BUFFER_BASE + buffNum) * 512 + offset];
    else
        [(BUFFER_BASE + buffNum) * 512 + offset] = word;
        [buffTab + 1] = 1;
    endif;

    multipush(R1,R2,R3,R4,R5);
    R1 = RELEASE_BUFFER; R2 = buffNum; R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER; 
    multipop(R1,R2,R3,R4,R5);
    
    return;
endif;  