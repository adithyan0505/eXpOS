alias procTab R1;
alias userSP R2;
userSP = SP;
procTab = PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16;
[procTab + 13] = SP;
SP = [procTab + 11] * 512 - 1;
[procTab + 9] = 21;

//check if invoked from shell of root user
if(([procTab + 1] != 1) || ([procTab + 3] != ROOT)) then
    [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = -1;
    [procTab + 9] = 0;
    SP = userSP;
    ireturn;
endif;

multipush(R1,R2);
R1 = KILL_ALL; R2 = [SYSTEM_STATUS_TABLE + 1];
call PROCESS_MANAGER;
multipop(R1,R2);

alias buffIdx R3;
buffIdx = 0;
while(buffIdx < MAX_BUFFER) do
    if([BUFFER_TABLE + buffIdx * 4 + 1] == 1) then
        multipush(R1,R2,R3);
        R4 = [BUFFER_TABLE + buffIdx * 4];
        R3 = BUFFER_BASE + buffIdx;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        R1 = DISK_STORE;
        call DEVICE_MANAGER;
        multipop(R1,R2,R3);
    endif;  
    buffIdx = buffIdx + 1;
endwhile;

//commit onto disk memory copies of 
//inode table, user table, root file, disk free list
R1 = DISK_STORE; R2 = [SYSTEM_STATUS_TABLE + 1]; R3 = 59; R4 = 3;
call DEVICE_MANAGER;
R1 = DISK_STORE; R2 = [SYSTEM_STATUS_TABLE + 1]; R3 = 60; R4 = 4;
call DEVICE_MANAGER;
R1 = DISK_STORE; R2 = [SYSTEM_STATUS_TABLE + 1]; R3 = 62; R4 = 5;
call DEVICE_MANAGER;
R1 = DISK_STORE; R2 = [SYSTEM_STATUS_TABLE + 1]; R3 = 61; R4 = 2;
call DEVICE_MANAGER;

halt;