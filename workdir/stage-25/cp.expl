int main() {
    decl
        int temp, fd1, fd2;
        string file1, file2, word;
    enddecl

    begin
        temp = exposcall("Read",-1,file1);
        temp = exposcall("Read",-1,file2);

        fd1 = exposcall("Open",file1);
        if(fd1 < 0) then
            temp = exposcall("Write",-2,"Error");
        else    
            temp = exposcall("Create",file2);
            if(temp == -1) then
                temp = exposcall("Write",-2,"InodeFull");
            else
                fd2 = exposcall("Open",file2);
                if(fd2 < 0) then
                    temp = exposcall("Write",-2,"Error");
                else    
                    while(1 == 1) do
                        temp = exposcall("Read",fd1,word);
                        if(temp == -2) then
                            break;
                        endif;
                        temp = exposcall("Write",fd2,word);
                    endwhile;
                    temp = exposcall("Close",fd2);
                endif;
            endif;
            temp = exposcall("Close",fd1);
        endif;
        return 0;
    end
}