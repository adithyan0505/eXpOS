// set MODE FLAG in process table as system call number
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 5;
alias userSP R1;
userSP = SP;
// switch from user stack to kernel stack
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

alias fd R2;
fd = [[PTBR + 2 * (userSP - 4) / 512] * 512 + (userSP - 4) % 512];
alias retValLoc R3;
retValLoc = ([PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512);

if (fd == -2) then
	// FD for terminal write
	alias word R4;
	word = [[PTBR + 2 * (userSP - 3) / 512] * 512 + (userSP - 3) % 512];
	multipush(R1, R2, R3, R4);
	R1 = TERMINAL_WRITE; R2 = [SYSTEM_STATUS_TABLE + 1]; R3 = word;
	call DEVICE_MANAGER;
	multipop(R1, R2, R3, R4);
	// set return value, switch back to user stack
	[retValLoc] = 0;
	SP = userSP;
	[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
	ireturn;
endif;

if((fd > 7) || (fd < 0)) then
	//invalid FD
	[retValLoc] = -1;
	SP = userSP;
	[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
	ireturn;
endif;

alias rtAddr R4;
rtAddr = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 + RESOURCE_TABLE_OFFSET + 2 * fd;

if([rtAddr] != FILE) then
	//invalid FD
	[retValLoc] = -1;
	SP = userSP;
	[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
	ireturn;
endif;

alias oftIdx R5;
oftIdx = [rtAddr + 1];
alias inodeIdx R6;
inodeIdx = [OPEN_FILE_TABLE + oftIdx * 4];

alias currUsr R7;
currUsr = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 3];
if((currUsr != ROOT) && (currUsr != [INODE_TABLE + inodeIdx * 16 + 3]) && ([INODE_TABLE + inodeIdx * 16 + 3] == EXCLUSIVE)) then
	[retValLoc] = -3;
	SP = userSP;
	[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
	ireturn;
endif;

//acquire inode
multipush(R1,R2,R3,R4,R5,R6,R7);
R1 = ACQUIRE_INODE; R2 = inodeIdx; R3 = [SYSTEM_STATUS_TABLE + 1];
call RESOURCE_MANAGER;
multipop(R1,R2,R3,R4,R5,R6,R7);
if(R0 == -1) then
	[retValLoc] = -1;
	SP = userSP;
	[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
	ireturn;
endif;

alias lseek R8;
lseek = [OPEN_FILE_TABLE + 4 * oftIdx + 2];

if(lseek == MAX_FILE_SIZE) then
	//release inode
	multipush(R1,R2,R3,R4,R5,R6,R7);
	R1 = RELEASE_INODE; R2 = inodeIdx; R3 = [SYSTEM_STATUS_TABLE + 1];
	call RESOURCE_MANAGER;
	multipop(R1,R2,R3,R4,R5,R6,R7);
	//return -2
	[retValLoc] = -2;
	SP = userSP;
	[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
	ireturn;
endif;

alias fileSize R9;
fileSize = [INODE_TABLE + inodeIdx * 16 + 2];
if((lseek % 512 == 0) && (fileSize == lseek)) then
	//allocate new block
	multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9);
	R1 = GET_FREE_BLOCK;
	call MEMORY_MANAGER;
	multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9);
	if(R0 == -1) then
		[retValLoc] = -2;
		SP = userSP;
		[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
		ireturn;
	endif;
	[INODE_TABLE + inodeIdx * 16 + 8 + lseek / 512] = R0;
endif;

alias dblk R10;
dblk = [INODE_TABLE + inodeIdx * 16 + 8 + lseek / 512];
alias offset R11;
offset = lseek % 512;

multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11);
R4 = [[PTBR + 2 * (userSP - 3) / 512] * 512 + (userSP - 3) % 512];
R1 = BUFFERED_WRITE; R2 = dblk; R3 = offset;
call FILE_MANAGER;
multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11);

if(lseek == fileSize) then
	//increment file size in inode table and root file
	[INODE_TABLE + inodeIdx * 16 + 2] = fileSize + 1;
	[ROOT_FILE + inodeIdx * 8 + 1] = fileSize + 1;
endif;

//increment lseek
[OPEN_FILE_TABLE + 4 * oftIdx + 2] = lseek + 1;

//release inode and return to user mode
multipush(R1,R2,R3);
R1 = RELEASE_INODE; R2 = inodeIdx; R3 = [SYSTEM_STATUS_TABLE + 1];
call RESOURCE_MANAGER;
multipop(R1,R2,R3);
[retValLoc] = 0;
SP = userSP;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
ireturn;