alias procTab R1;
alias userSP R2;
userSP = SP;
procTab = PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16;
[procTab + 13] = SP;
SP = [procTab + 11] * 512 - 1;
[procTab + 9] = 28;
alias retLoc R3;
retLoc = ([PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512);

if([SYSTEM_STATUS_TABLE + 1] != SHELL_PROCESS) then
    [retLoc] = -1;
    [procTab + 9] = 0;
    SP = userSP;
    ireturn;
endif;

//kill all user process except shell
multipush(R1,R2,R3);
R1 = KILL_ALL; R2 = [SYSTEM_STATUS_TABLE + 1];
call PROCESS_MANAGER;
multipop(R1,R2,R3);

[procTab + 4] = TERMINATED;

//set entry point IP to top of user stack and reset user SP
[[PTBR + 16] * 512] = [[PTBR + 8] * 512 + 1];
[procTab + 13] = 8 * 512;

//wake up login process, set current user to kernel
[PROCESS_TABLE + LOGIN_PROCESS * 16 + 4] = READY;
[SYSTEM_STATUS_TABLE] = KERNEL;

call SCHEDULER;

//control flow will never reach here
//as state set as terminated

